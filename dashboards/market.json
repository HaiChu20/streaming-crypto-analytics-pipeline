    {
      "id": 11,
      "title": "Data freshness & book validity",
      "type": "table",
      "description": "Freshness = server now \u2212 latest tick in the selected range; book_valid_share and invalid_book_ticks summarize that range. Invalid books are the engine drop/resync signal; warmup is the latest tick flag.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "crypto-clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "crypto-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT exchange, market, symbol, engine_version,\n    max(ts) AS last_tick,\n    dateDiff('millisecond', max(ts), now64(3)) / 1000.0 AS freshness_s,\n    avg(toUInt8(book_valid)) AS book_valid_share,\n    argMax(tuple(book_age_ms), tick_ns).1 AS book_age_ms,\n    countIf(NOT book_valid) AS invalid_book_ticks,\n    argMax(warmup, tick_ns) AS warmup\nFROM crypto.features FINAL\nWHERE $__timeFilter(ts) AND if(${asset:sqlstring} = 'BTC', match(symbol, 'BTC|XBT'), position(symbol, 'ETH') > 0) AND exchange != 'cross'\nGROUP BY exchange, market, symbol, engine_version\nORDER BY freshness_s DESC",
          "format": 1,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 12,
      "title": "Predicted vs realized return (%)",
      "type": "timeseries",
      "description": "Empty until phase 6. Returns are 100 \u00d7 (mid(t+h)/mid(t) \u2212 1), aligned to prediction time. Realized values stay NULL until a valid future tick exists. Latest available feature engine version supplies each target price.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "crypto-clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "crypto-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "rawSql": "WITH prices AS (\n    SELECT concat(exchange, '.', market, '.', ${asset:sqlstring}) AS target,\n        tick_ns, argMax(mid, tuple(available_ns, engine_version)) AS reference_mid\n    FROM crypto.features FINAL\n    WHERE ts >= $__fromTime AND ts <= $__toTime + INTERVAL 30 MINUTE\n        AND if(${asset:sqlstring} = 'BTC', match(symbol, 'BTC|XBT'), position(symbol, 'ETH') > 0) AND exchange != 'cross' AND mid IS NOT NULL AND book_valid\n    GROUP BY target, tick_ns\n)\nSELECT p.ts AS time,\n    concat(p.target, ' / ', toString(p.horizon_s), 's / ', p.model_version, ' / ', item.1) AS metric,\n    item.2 AS value\nFROM crypto.predictions AS p FINAL\nLEFT JOIN prices AS start ON start.target = p.target AND start.tick_ns = p.tick_ns\nLEFT JOIN prices AS finish ON finish.target = p.target\n    AND finish.tick_ns = p.tick_ns + toInt64(p.horizon_s) * 1000000000\nARRAY JOIN [\n    ('predicted', toNullable(p.pred_return_pct)),\n    ('realized', 100.0 * (finish.reference_mid / nullIf(start.reference_mid, 0) - 1.0))\n] AS item\nWHERE $__timeFilter(p.ts) AND endsWith(p.target, concat('.', ${asset:sqlstring}))\nORDER BY time\nSETTINGS join_use_nulls = 1",
          "format": 0,
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }

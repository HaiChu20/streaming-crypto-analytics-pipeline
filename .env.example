# Copy to .env (gitignored) and fill in.
# Kraken API key with ONLY the "WebSocket interface" permission (no trading/funds/withdrawal).
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DATA_DIR=data

# Existing admin profile, used only by aws_setup.sh to provision infrastructure and an access key.
AWS_ADMIN_PROFILE=
# Least-privilege profile; aws_setup.sh creates it once, and archive_daily uses it.
AWS_PROFILE=crypto-archiver
AWS_REGION=eu-north-1
S3_BUCKET=
TF_VAR_bucket_name=${S3_BUCKET}
TF_VAR_region=${AWS_REGION}
TF_VAR_budget_email=
TF_VAR_budget_usd=10
# Empty = never delete locally. The plan value is 48; enable only after verifying the archive.
ARCHIVE_DELETE_LOCAL_AFTER_H=

# Live inference: empty version disables the service. Root contains models/<target>/<h>/<version>.
INFERENCE_MODELS_ROOT=data
INFERENCE_MODEL_VERSION=

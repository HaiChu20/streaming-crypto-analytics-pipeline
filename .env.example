# Copy to .env (gitignored) and fill in.
# Kraken API key with ONLY the "WebSocket interface" permission (no trading/funds/withdrawal).
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DATA_DIR=data

# Existing SDK profile used by archive_daily (default: crypto-archiver).
AWS_PROFILE=crypto-archiver
AWS_REGION=eu-north-1
S3_BUCKET=
# source: AWS Price List API, eu-north-1, fetched 2026-10-17
# https://pricing.us-east-1.amazonaws.com/offers/v1.0/aws/AmazonS3/current/eu-north-1/index.json
S3_PRICE_GB_MONTH=0.023
S3_PRICE_PUT_PER_1000=0.005
# Empty = retain local files; enable local deletion only after verifying the archive.
ARCHIVE_DELETE_LOCAL_AFTER_H=

# Live inference: empty version disables the service. Root contains models/<target>/<h>/<version>.
INFERENCE_MODELS_ROOT=data
INFERENCE_MODEL_VERSION=
